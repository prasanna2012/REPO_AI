# GEMINI_API_KEY: Optional if running locally with Ollama (Qwen2.5-Coder:7b)
# In AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="APIKEY"

# APP_URL: The URL where this app is hosted locally or in the cloud.
APP_URL="http://localhost:3000"

# PORT: Local server port (default 3000)
PORT=3000

# OLLAMA_HOST: Local open-source model endpoint
OLLAMA_HOST="http://localhost:11434"
